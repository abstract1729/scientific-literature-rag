# ============================================================
# Experiment outputs
# ============================================================

# Ignore temporary/generated experiment artifacts by default
results/*

# Keep directory structure
!results/.gitkeep

# Keep reproducible experiment reports/metrics
!results/**/*.json
!results/**/*.jsonl
!results/**/*.csv
!results/**/*.md

# Experiment-generated temporary outputs
experiments/**/outputs/
experiments/**/logs/


